    {
      "parameters": {
        "jsCode": "\nconst FREEMAIL = ['gmail','googlemail','yahoo','outlook','hotmail','live','msn','icloud','me','aol','proton','protonmail'];\nconst SPECIAL = { github: 'GitHub', n8n: 'n8n', linkedin: 'LinkedIn', youtube: 'YouTube', paypal: 'PayPal', openai: 'OpenAI' };\nfunction labelFor(from) {\n  const m = String(from || '').match(/@([A-Za-z0-9.-]+)/);\n  if (!m) return null;\n  const parts = m[1].toLowerCase().split('.').filter(Boolean);\n  if (parts.length < 2) return null;\n  const second = parts[parts.length - 2];\n  const tld = parts[parts.length - 1];\n  const compound = tld.length === 2 && ['co','com','org','net','gov','ac','edu'].includes(second) && parts.length >= 3;\n  const name = compound ? parts[parts.length - 3] : second;\n  if (FREEMAIL.includes(name)) return null;\n  return SPECIAL[name] || name.charAt(0).toUpperCase() + name.slice(1);\n}\n\nconst existing = new Set($('Get existing labels').all().map(i => String(i.json.name || '').toLowerCase()));\nconst wanted = new Map();\nfor (const m of $('Get many messages').all()) {\n  const label = labelFor(m.json.From);\n  if (label && !existing.has(label.toLowerCase())) wanted.set(label.toLowerCase(), label);\n}\nconst names = [...wanted.values()];\nif (names.length === 0) return [{ json: { needsCreate: false } }];\nreturn names.map(labelName => ({ json: { needsCreate: true, labelName } }));"
      },
